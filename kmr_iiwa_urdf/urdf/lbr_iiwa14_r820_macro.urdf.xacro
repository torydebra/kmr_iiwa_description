<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- include helper xacros -->
  <xacro:include filename="$(find kmr_iiwa_urdf)/urdf/common_materials.xacro"/>
  <xacro:macro name="kuka_lbr_iiwa14_r820_robot" params="prefix">
    <!-- links - main serial chain -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.1 0 0.07" rpy="0 0 0"/>
        <mass value="5"/>
        <inertia ixx="0.05"  ixy="0"  ixz="0" iyy="0.06" iyz="0" izz="0.03" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/base_link.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_ral_cream_white/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/base_link.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_1">
      <inertial>
        <origin xyz="0 -0.03 0.12" rpy="0 0 0"/>
        <mass value="4"/>
        <inertia ixx="0.1"  ixy="0"  ixz="0" iyy="0.09" iyz="0" izz="0.02" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_1.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_ral_cream_white/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_1.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_2">
      <inertial>
        <origin xyz="0.0003 0.059 0.042" rpy="0 0 0"/>
        <mass value="4"/>
        <inertia ixx="0.05"  ixy="0"  ixz="0" iyy="0.018" iyz="0" izz="0.044" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_2.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_orange/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_2.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_3">
      <inertial>
        <origin xyz="0 0.03 0.13" rpy="0 0 0"/>
        <mass value="3"/>
        <inertia ixx="0.08"  ixy="0"  ixz="0" iyy="0.075" iyz="0" izz="0.01" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_3.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_ral_cream_white/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_3.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_4">
      <inertial>
        <origin xyz="0 0.067 0.034" rpy="0 0 0"/>
        <mass value="2.7"/>
        <inertia ixx="0.03"  ixy="0"  ixz="0" iyy="0.01" iyz="0" izz="0.029" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_4.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_ral_cream_white/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_4.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_5">
      <inertial>
        <origin xyz="0.0001 0.021 0.076" rpy="0 0 0"/>
        <mass value="1.7"/>
        <inertia ixx="0.02"  ixy="0"  ixz="0" iyy="0.018" iyz="0" izz="0.005" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_5.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_ral_cream_white/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_5.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_6">
      <inertial>
        <origin xyz="0 0.0006 0.0004" rpy="0 0 0"/>
        <mass value="1.8"/>
        <inertia ixx="0.005"  ixy="0"  ixz="0" iyy="0.0036" iyz="0" izz="0.0047" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_6.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_orange/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_6.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_7">
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/visual/link_7.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <xacro:material_kuka_ral_cream_white/>
      </visual>
      <collision>
        <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find kmr_iiwa_urdf)/meshes/lbr_iiwa14_r820/collision/link_7.stl"/>
        </geometry>
      </collision>
    </link>
    <!-- joints - main serial chain -->
    <joint name="${prefix}joint_1" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.1575"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="0" lower="${radians(-170)}" upper="${radians(170)}" velocity="${radians(85)}"/>
    </joint>
    <joint name="${prefix}joint_2" type="fixed">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.2025"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit effort="0" lower="${radians(-120)}" upper="${radians(120)}" velocity="${radians(85)}"/>
    </joint>
    <joint name="${prefix}joint_3" type="fixed">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.2045"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="0" lower="${radians(-170)}" upper="${radians(170)}" velocity="${radians(100)}"/>
    </joint>
    <joint name="${prefix}joint_4" type="fixed">
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.2155"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <limit effort="0" lower="${radians(-120)}" upper="${radians(120)}" velocity="${radians(75)}"/>
    </joint>
    <joint name="${prefix}joint_5" type="fixed">
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.1845"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="0" lower="${radians(-170)}" upper="${radians(170)}" velocity="${radians(130)}"/>
    </joint>
    <joint name="${prefix}joint_6" type="fixed">
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.2155"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit effort="0" lower="${radians(-120)}" upper="${radians(120)}" velocity="${radians(135)}"/>
    </joint>
    <joint name="${prefix}joint_7" type="fixed">
      <parent link="${prefix}link_6"/>
      <child link="${prefix}link_7"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.081"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="0" lower="${radians(-175)}" upper="${radians(175)}" velocity="${radians(135)}"/>
    </joint>
    <!-- ROS-Industrial 'base' frame - equivalent of 'KUKA ROBROOT'-->
    <link name="${prefix}base"/>
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>
    <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
    <link name="${prefix}flange"/>
    <joint name="${prefix}link7-flange" type="fixed">
      <parent link="${prefix}link_7"/>
      <child link="${prefix}flange"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.071"/>
    </joint>
    <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}link7-tool0" type="fixed">
      <parent link="${prefix}link_7"/>
      <child link="${prefix}tool0"/>
      <origin rpy="-0.0 0.0 0.0" xyz="0.0 0.0 0.071"/>
    </joint>
  </xacro:macro>
</robot>